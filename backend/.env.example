DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/fems_db?schema=public"
JWT_ACCESS_SECRET="generate-with-node-crypto-32-bytes-hex"
JWT_REFRESH_SECRET="generate-another-32-bytes-hex"
PORT=4000
FRONTEND_URL="http://localhost:3000"
RESET_PASSWORD_URL="http://localhost:3000/reset-password"
NODE_ENV=development

# Email OTP (e.g. Gmail: smtp.gmail.com, app password as SMTP_PASSWORD)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your.email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM="TZW LTD <your.email@gmail.com>"
